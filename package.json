{
  "name": "novoapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --go --lan",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --go --android --lan",
    "ios": "expo start --go --ios --lan",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "start:offline": "expo start --go --offline",
    "expo:lan": "node scripts/expo-go.cjs --mode lan",
    "expo:tunnel": "node scripts/expo-go.cjs --mode tunnel",
    "expo:check": "node scripts/expo-go.cjs --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-picker/picker": "^2.11.4",
    "expo": "~58.0.26",
    "expo-checkbox": "~58.0.2",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
